# 기본: 텍스트는 자동 판별, 저장소에는 LF 로 정규화
* text=auto

# ── Unity ──
# 씬/프리팹/에셋은 YAML 이지만 병합이 까다롭다. Smart Merge 를 쓰려면
# git config merge.unityyamlmerge.cmd 를 UnityYAMLMerge 로 잡아야 한다.
*.unity     text eol=lf merge=unityyamlmerge
*.prefab    text eol=lf merge=unityyamlmerge
*.asset     text eol=lf merge=unityyamlmerge
*.mat       text eol=lf merge=unityyamlmerge
*.anim      text eol=lf merge=unityyamlmerge
*.controller text eol=lf merge=unityyamlmerge
*.meta      text eol=lf
*.cs        text eol=lf diff=csharp

# Unity Hub 의 파서는 이 파일이 LF 면 에디터 버전을 읽지 못한다 ("제한된 에디터 버전" 경고).
# Unity 자신이 CRLF 로 쓰므로 체크아웃 시에도 CRLF 를 강제한다.
ProjectVersion.txt text eol=crlf

# ── 스크립트/데이터 ──
*.ps1       text eol=crlf
*.json      text eol=lf
*.md        text eol=lf
*.html      text eol=lf
*.js        text eol=lf
*.csproj    text eol=lf

# ── 바이너리 (줄바꿈 변환 금지) ──
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.psd       binary
*.xlsx      binary
*.xls       binary
*.dll       binary
*.exe       binary
*.ttf       binary
*.otf       binary
*.wav       binary
*.mp3       binary
*.ogg       binary
*.unitypackage binary
